generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DB_URL")
}

// modelo de Grupos de Usuários
model Grupo {
    id         String   @id @default(uuid())
    nome       String
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    // Relacionamento com os usuários
    usuario Usuario[]

    @@map("grupos")
}

// modelo de Usuários
model Usuario {
    id                 String   @id @default(uuid())
    nome               String
    email              String   @unique
    senha              String
    tokenRecuperaSenha String?  @db.VarChar(1024)
    fotoPerfil         String?
    ativo              Boolean  @default(true)
    grupoId            String
    created_at         DateTime @default(now())
    updated_at         DateTime @updatedAt

    // Relacionamentos
    inscricoes      Inscricao[]
    certificados    Certificado[]
    progressoCursos ProgressoCurso[]
    instrutores     Instrutores[]
    Grupo           Grupo            @relation(fields: [grupoId], references: [id])
}

// modelo de Inscrições em Cursos
model Inscricao {
    cursoId       String
    userId        String
    status        String   @default("Em Andamento")
    dataInscricao DateTime @default(now())
    created_at    DateTime @default(now())
    updated_at    DateTime @updatedAt

    // Relacionamento com o curso e usuário
    curso   Curso   @relation(fields: [cursoId], references: [id])
    usuario Usuario @relation(fields: [userId], references: [id])

    @@id([userId, cursoId])
    @@map("inscricoes")
}

// modelo de Progresso do Curso
model ProgressoCurso {
    userId               String
    cursoId              String
    porcentagem          Float
    atividadeAtual       String?
    atividadesConcluidas Json?
    created_at           DateTime @default(now())
    updated_at           DateTime @updatedAt

    // Relacionamento com o curso e usuário
    curso    Curso          @relation(fields: [cursoId], references: [id])
    usuario  Usuario        @relation(fields: [userId], references: [id])
    conteudo ConteudoCurso? @relation(fields: [atividadeAtual], references: [id])

    @@id([userId, cursoId])
    @@map("progresso_cursos")
}

// modelo de Conteúdo do Curso
model ConteudoCurso {
    id           String   @id @default(uuid())
    topicoId     String
    tipo         String // tipo de conteúdo (texto, vídeo, questão, etc.)
    conteudo     String // conteúdo em si (texto formatado, URL do vídeo, etc.)
    cargaHoraria String
    ordem        Int
    created_at   DateTime @default(now())
    updated_at   DateTime @updatedAt

    // Relacionamento com o topico
    topico Topico @relation(fields: [topicoId], references: [id])

    progressoCurso ProgressoCurso[]

    @@map("conteudos_cursos")
}

// modelo de topicos
model Topico {
    id         String   @id @default(uuid())
    titulo     String
    ordem      Int
    cursoId    String
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    // Relacionamento com o curso
    curso Curso @relation(fields: [cursoId], references: [id])

    // Relacionamento com o conteúdo
    conteudos ConteudoCurso[]

    @@map("topicos")
}

// modelo de Cursos
model Curso {
    id         String   @id @default(uuid())
    nome       String
    descricao  String   @db.Text
    capa       String?
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    // Relacionamentos
    inscricoes      Inscricao[]
    topicos         Topico[]
    progressoCursos ProgressoCurso[]
    certificado     Certificado[]
    instrutores     Instrutores[]
    categoria       Categoria[]
}

// Criar um modelo de categoria de cursos para organizar os cursos
model Categoria {
    id         String   @id @default(uuid())
    nome       String
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    // Relacionamento com os cursos
    cursos Curso[]

    @@map("categorias")
}

// modelo de Instrutores
model Instrutores {
    id             String   @id @default(uuid())
    cursoId        String
    userId         String
    criadorDoCurso Boolean  @default(false)
    created_at     DateTime @default(now())
    updated_at     DateTime @updatedAt

    curso   Curso   @relation(fields: [cursoId], references: [id])
    usuario Usuario @relation(fields: [userId], references: [id])

    @@unique([cursoId, userId])
    @@map("instrutores")
}

// modelo de Certificados
model Certificado {
    userId     String
    cursoId    String
    validador  String   @unique @default(uuid())
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    // Relacionamento com o curso e usuário
    curso   Curso   @relation(fields: [cursoId], references: [id])
    usuario Usuario @relation(fields: [userId], references: [id])

    @@id([userId, cursoId])
    @@map("certificados")
}
