generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DB_URL")
}

// modelo de Grupos de Usuários
model Grupo {
    id         String   @id @default(uuid())
    nome       String
    regraId    String
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    // Relacionamento com os usuários

    // usuario        Usuario[]
    regrasOnGrupos Regras_Grupo[]
    usuarioOnGrupo UsuarioOnGrupo[]
}

//regras de acesso a grupos
model Regra {
    id         String   @id @default(uuid())
    nome       String
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    regrasOnGrupos Regras_Grupo[]
}

model Regras_Grupo {
    grupoId    String
    regrasId   String
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    grupo Grupo @relation(fields: [grupoId], references: [id])
    Regra Regra @relation(fields: [regrasId], references: [id])

    @@id([regrasId, grupoId])
}

// modelo de Usuários
model Usuario {
    id                 String   @id @default(uuid())
    nome               String
    email              String   @unique
    senha              String
    tokenRecuperaSenha String?
    fotoPerfil         String?
    ativo              Boolean  @default(true)
    //grupoId         String
    created_at         DateTime @default(now())
    updated_at         DateTime @updatedAt

    // Relacionamentos
    inscricoes      Inscricao[]
    certificados    Certificado[]
    progressoCursos ProgressoCurso[]
    instrutores     instrutores[]
    usuarioOnGrupo  UsuarioOnGrupo[]
    //Grupo           Grupo           @relation(fields: [grupoId], references: [id])
}

model UsuarioOnGrupo {
    grupoId    String
    usuarioId  String
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    Grupo   Grupo   @relation(fields: [grupoId], references: [id])
    Usuario Usuario @relation(fields: [usuarioId], references: [id])

    @@id([grupoId, usuarioId])
}

// modelo de Inscrições em Cursos
model Inscricao {
    id            String   @id @default(uuid())
    cursoId       String
    userId        String
    status        String
    dataInscricao DateTime
    created_at    DateTime @default(now())
    updated_at    DateTime @updatedAt

    // Relacionamento com o curso e usuário
    curso   Curso   @relation(fields: [cursoId], references: [id])
    usuario Usuario @relation(fields: [userId], references: [id])
}

// modelo de Progresso do Curso
model ProgressoCurso {
    id              String   @id @default(uuid())
    userId          String
    cursoId         String
    porcentagem     Float
    ultimaAtividade String?
    created_at      DateTime @default(now())
    updated_at      DateTime @updatedAt

    // Relacionamento com o curso e usuário
    curso   Curso   @relation(fields: [cursoId], references: [id])
    usuario Usuario @relation(fields: [userId], references: [id])
}

// modelo de Certificados

// modelo de Conteúdo do Curso
model ConteudoCurso {
    id         String   @id @default(uuid())
    aulaId     String
    tipo       String // tipo de conteúdo (texto, vídeo, questão, etc.)
    conteudo   String // conteúdo em si (texto formatado, URL do vídeo, etc.)
    ordem      Int
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    // Relacionamento com a aula
    aula Aula @relation(fields: [aulaId], references: [id])
}

// modelo de Aulas
model Aula {
    id         String   @id @default(uuid())
    titulo     String
    ordem      Int
    cursoId    String
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    // Relacionamento com o curso
    curso Curso @relation(fields: [cursoId], references: [id])

    // Relacionamento com o conteúdo
    conteudos ConteudoCurso[]
}

// modelo de Cursos
model Curso {
    id            String   @id @default(uuid())
    nome          String
    descricao     String?
    identificador String
    created_at    DateTime @default(now())
    updated_at    DateTime @updatedAt

    // Relacionamentos
    inscricoes      Inscricao[]
    aulas           Aula[]
    progressoCursos ProgressoCurso[]
    certificado     Certificado[]
    instrutores     instrutores[]
}

model instrutores {
    id         String   @id @default(uuid())
    cursoId    String
    userId     String
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    curso   Curso   @relation(fields: [cursoId], references: [id])
    usuario Usuario @relation(fields: [userId], references: [id])
}

model Certificado {
    userId      String
    cursoId     String
    dataEmissao DateTime
    validador   String
    created_at  DateTime @default(now())
    updated_at  DateTime @updatedAt

    // Relacionamento com o curso e usuário
    curso   Curso   @relation(fields: [cursoId], references: [id])
    usuario Usuario @relation(fields: [userId], references: [id])

    @@id([userId, cursoId])
}
